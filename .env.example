# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recd_tracker"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# File storage (S3-compatible) - PLACEHOLDERS: no S3 integration exists in the code yet, nothing reads these. (Site photos
# and signed service reports are kept in the database; see REPORT_STORAGE below.)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# Email notifications (SMTP) - used for ordinary notifications, NOT for one-time codes
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=

# One-time codes (login OTP and public complaint OTP) are sent by WhatsApp (Meta Cloud API) to the registered
# mobile number. Until these two are set, code requests answer "not available" (503) - there is no email fallback.
# Codes are hashed with JWT_SECRET (above), so keep that secret stable and private.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved WhatsApp *authentication* template with one body parameter + a copy-code button (see lib/otpDelivery.ts)
WHATSAPP_OTP_TEMPLATE_NAME=recd_otp
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# LOCAL DEVELOPMENT ONLY: set to 1 to get the code in the API response instead of a WhatsApp message (nothing is
# sent). Off by default, ignored when NODE_ENV=production and on hosted platforms (Vercel, Render, ...). Never set
# this on a server. (PUBLIC_OTP_DEV_ECHO=1 is the older name and still works.)
OTP_DEV_ECHO=

# Optional: a dedicated key for hashing one-time codes. Unset = JWT_SECRET is used (nothing to change on existing servers).
# At least 16 characters. Setting or changing it invalidates codes pending at that moment (5-10 minutes) and nothing else.
OTP_HMAC_SECRET=

# Which reverse proxies the API believes about a visitor's address (drives the per-IP rate limits). Unset = trust none.
# A number = how many proxy hops sit in front of the API (e.g. 1), or a list such as "loopback, 10.0.0.0/8".
# "true" is refused. The hosting owner must set the real value - on a platform proxy all visitors otherwise share one limit bucket.
TRUST_PROXY=

# Not wired up yet (stubbed channels)
SMS_PROVIDER_API_KEY=
TELEGRAM_BOT_TOKEN=

# Signed service reports (signature PNG + final PDF). "database" (default and the only implemented provider) keeps them in
# the ReportFile table. Any other value makes the signing / download endpoints answer 503 "storage not configured".
REPORT_STORAGE=database

# Scheduled jobs (Vercel Cron sends this as a Bearer token): AMC expiry reminders, ticket SLA escalation, service reminders.
# Every cron route refuses to run when this is unset. Set it on the host; do not commit a real value.
CRON_SECRET=

# API
PORT=4000
ADMIN_WEB_URL="http://localhost:3000"

# Browser origins allowed to call the API (CORS). ADMIN_WEB_URL above is always allowed; add more origins here, comma separated
# (scheme://host[:port], no wildcard - "*" and malformed entries are refused). The local development origins
# (http://localhost:3000 and :8081) are allowed only outside production / hosted platforms. In production set ADMIN_WEB_URL to the real
# admin web address - otherwise no browser origin is trusted. CORS is not authentication; every route still requires a login.
CORS_ALLOWED_ORIGINS=

# Database seed (apps/api/prisma/seed.ts). There is NO default password.
#  - Production / any non-local database: the seed creates only reference data (roles, permissions, stages ...). If no Super Admin exists yet it
#    REFUSES to run unless these two are set (a strong password: 12+ characters, letters and digits, nothing well-known). The account is created
#    once, must change its password at first sign-in, and is never touched by later runs. Remove the variables afterwards.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=
#  - Local development database (localhost) only: demo accounts are created. Give them a password with SEED_DEV_PASSWORD (same strength rules);
#    left empty they are created WITHOUT a password. Set SEED_SAMPLE_DATA=0 to skip the demo data. Demo accounts are refused anywhere else.
SEED_DEV_PASSWORD=
SEED_SAMPLE_DATA=

# Optional: set to 1 to send the daily region-wise Service Manager digest (rides on the 04:00 UTC reminders cron). Off when unset.
SERVICE_DIGEST_ENABLED=
