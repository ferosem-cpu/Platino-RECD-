{
  "buildCommand": "npm run build",
  "regions": ["bom1"],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/amc-orders/send-expiry-reminders",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/complaints/cron/escalate",
      "schedule": "30 3 * * *"
    }
  ]
}
