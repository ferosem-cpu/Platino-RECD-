// RECD Project & Service Tracker - data model
//
// Design rule (see project memory): anything that might grow a new value
// later - stages, statuses, roles, permissions, photo checkpoints, structure
// types - is a row in a lookup table, never a hardcoded Prisma enum. Prisma
// `enum` is used only for genuinely fixed, structural categories that are
// not expected to grow (e.g. pending-action owner type, complaint severity).
// Well-known lookup-table `key` values that application code branches on
// live in packages/shared/src/constants.ts and must match the seed data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Transaction-mode pooler (IPv4, pgbouncer) - what the running app uses for queries.
  url       = env("DATABASE_URL")
  // Session-mode pooler - what `prisma migrate` uses; transaction-mode pgbouncer doesn't
  // reliably support the advisory locks and DDL migrations need.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth, roles, permissions
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String?  @unique
  phone               String?  @unique
  passwordHash        String?
  isActive            Boolean  @default(true)
  mustChangePassword  Boolean  @default(true)
  /// Informal job title shown in the UI only (e.g. "Proprietor", "CTO", "Fitter", "Welder") -
  /// does not affect permissions, which come entirely from `role`.
  title               String?
  roleId              String
  role                Role     @relation(fields: [roleId], references: [id])
  customerId          String?
  customer            Customer? @relation("CustomerContacts", fields: [customerId], references: [id])
  /// Erection engineers belong to an external Vendor company (work is subcontracted). Null = internal staff.
  vendorId            String?
  vendor              Vendor?   @relation("VendorMembers", fields: [vendorId], references: [id])
  notificationChannels Json?   // array of NotificationChannel keys the user has opted into
  createdAt           DateTime @default(now())

  salesOrders          Order[]            @relation("SalesEngineer")
  customersOwned       Customer[]         @relation("CustomerSalesOwner")
  assignedSites        Site[]             @relation("AssignedEngineer")
  stageEventsCreated   SiteStageEvent[]
  photosUploaded       SitePhoto[]
  complaintsAssigned   Complaint[]        @relation("AssignedTo")
  pendingActionsOwned  PendingAction[]    @relation("InternalOwner")
  usersCreated         User[]             @relation("CreatedBy")
  createdById          String?
  createdBy            User?              @relation("CreatedBy", fields: [createdById], references: [id])
  otpCodes             OtpCode[]
  vendorsApproved      Vendor[]           @relation("VendorApprover")
  vendorsArchived      Vendor[]           @relation("VendorArchiver")
  amcOrdersCreated     AmcOrder[]         @relation("AmcOrderCreatedBy")
  amcExpiryRemindersCleared AmcOrder[]    @relation("AmcExpiryClearedBy")
  agentLlmProvidersCreated AgentLlmProvider[] @relation("AgentLlmProviderCreator")
  agentConversations       AgentConversation[] @relation("AgentConversationUser")
  agentPendingActionsCreated AgentPendingAction[] @relation("AgentPendingActionCreator")
  regionsManaged       RegionManager[]
  auditAsActor         UserAuditLog[]     @relation("AuditActor")
  auditAsTarget        UserAuditLog[]     @relation("AuditTarget")
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Customers & products
// ---------------------------------------------------------------------------

model Customer {
  id            String   @id @default(cuid())
  name          String
  address       String?
  salesOwnerId  String?
  salesOwner    User?    @relation("CustomerSalesOwner", fields: [salesOwnerId], references: [id])
  createdAt     DateTime @default(now())

  contacts  User[]   @relation("CustomerContacts")
  orders    Order[]
  complaints Complaint[]
  amcOrders  AmcOrder[]
}

/// External erection subcontractor. Not part of Platino. Self-registers, is approved by
/// management after due diligence, then its erection engineers are added as vendor-scoped users.
model Vendor {
  id           String    @id @default(cuid())
  name         String
  /// "pending" | "approved" | "rejected" | "archived" - see VENDOR_STATUS in packages/shared.
  status       String    @default("pending")
  contactName  String
  contactEmail String    @unique
  contactPhone String?
  address      String?
  approvedById String?
  approvedBy   User?     @relation("VendorApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  /// Set when a Super Admin/Management archives this vendor (see routes/vendors.ts's
  /// /:id/archive) - the vendor row and all its history (sites, complaints) stay intact,
  /// this just records who pulled it out of active use and when.
  archivedById String?
  archivedBy   User?     @relation("VendorArchiver", fields: [archivedById], references: [id])
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  members User[] @relation("VendorMembers")
  sites   Site[] @relation("VendorSites")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  model          String   @unique
  ratingSpec     String?
  /// Drives structure/scaffold sizing later - RECD weight scales proportionately with this.
  capacityKva    Decimal? @db.Decimal(10, 2)
  warrantyMonths Int?
  /// cylinder | triangle | rectangle (PRODUCT_SHAPE in packages/shared) - drives which
  /// dimension fields are meaningful on the structure/scaffold sizing UI.
  shape          String?
  /// Free-text, e.g. "1200 x 600 x 900 mm" or "Ø800mm x 1500mm H" - format depends on shape.
  dimensions     String?
  weightKg       Decimal? @db.Decimal(10, 2)
  /// 1 or 2 - the silencer type fitted to this RECD variant.
  silencerType   Int?
  createdAt      DateTime @default(now())

  orders             Order[]
  orderLineItems     OrderLineItem[]
  recdUnits          RecdUnit[]
  recdDeliveries     RecdDelivery[]
}

// ---------------------------------------------------------------------------
// Orders & sites
// ---------------------------------------------------------------------------

model Order {
  id                       String    @id @default(cuid())
  orderNumber              String    @unique
  customerId               String
  customer                 Customer  @relation(fields: [customerId], references: [id])
  productId                String
  product                  Product   @relation(fields: [productId], references: [id])
  quantity                 Int
  /// Nullable: multi-site import (e.g. from a delivery-tracking sheet) creates operational
  /// orders that don't have commercial figures yet - filled in later, or never. Sales-created
  /// orders still set this at creation.
  value                    Decimal?  @db.Decimal(12, 2)
  orderDate                DateTime?
  promisedDeliveryDate     DateTime?
  actualDispatchDate       DateTime?
  /// Set by the sales engineer at order time - "replace_existing_silencer" | "add_after_existing_exhaust"
  plannedExhaustHookupType String?
  salesEngineerId          String?
  salesEngineer            User?     @relation("SalesEngineer", fields: [salesEngineerId], references: [id])
  createdAt                DateTime  @default(now())

  /// Customer's purchase order number (null only on legacy orders created before this field).
  poNumber                 String?
  poDate                   DateTime?
  /// True when an admin knowingly created a second order against the same customer + PO number.
  poDuplicateFlag          Boolean   @default(false)

  site Site?
  units RecdUnit[]
  /// Additional RECD units delivered under this same order/site (e.g. a site takes a 500kva
  /// and a 380kva together) - the order's own productId/quantity above remains "unit 1",
  /// these are units 2+. A physically separate delivery/site instead gets its own sibling
  /// Order+Site row.
  lineItems OrderLineItem[]

  @@index([customerId, poNumber])
}

/// A second (or third...) RECD product added to an existing order/site, for when multiple
/// units are delivered to one physical location together. The alternative - a fully separate
/// Order+Site pair sharing the same address - is used when the units are commercially/
/// logistically distinct (different dispatch, etc). Both paths are exposed in the "Add
/// another unit" UI on the site detail page; this is the "same order" one.
model OrderLineItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())
  units     RecdUnit[]
}

model Site {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  address           String?
  gpsLat            Decimal? @db.Decimal(9, 6)
  gpsLng            Decimal? @db.Decimal(9, 6)
  assignedEngineerId String?
  assignedEngineer   User?   @relation("AssignedEngineer", fields: [assignedEngineerId], references: [id])

  /// "Site name" - the end-client / site-owner, i.e. the company that actually operates
  /// this premises (distinct from Order.customer, who we're contracted with). Also doubles
  /// as the Company Name captured by the customer-portal Company Details form (§20).
  companyName     String?
  sitePocName     String?
  sitePocNumber   String?

  /// Google Drive folders for this site's photographs and drawings (company Drive account -
  /// see lib/googleDrive.ts). Created on demand via POST /sites/:id/drive-folders. The *Url
  /// fields are Drive's webViewLink, so the admin UI can link straight to the folder.
  photosDriveFolderId    String?
  photosDriveFolderUrl   String?
  drawingsDriveFolderId  String?
  drawingsDriveFolderUrl String?

  /// The external vendor company responsible for erecting this site (null = handled internally).
  vendorId String?
  vendor   Vendor? @relation("VendorSites", fields: [vendorId], references: [id])

  currentStageId String
  currentStage   StageDefinition @relation(fields: [currentStageId], references: [id])

  /// Set by the erection engineer on-site once they've seen the generator. If it differs
  /// from order.plannedExhaustHookupType, see the PendingAction created for customer approval.
  confirmedExhaustHookupType String?

  // Structure / scaffold module - schema ready now, no UI behind it until Phase 2.
  dgCapacityKva        Decimal?  @db.Decimal(10, 2)
  dgModel              String?
  structureTypeId      String?
  structureType        StructureType? @relation(fields: [structureTypeId], references: [id])
  structureDimensions  Json?
  structureDiagramUrl  String?
  structureDiagramStatus String? // null | "pending" | "ready" - stays "pending" until Phase 2 engine exists

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stageEvents     SiteStageEvent[]
  photos          SitePhoto[]
  pendingActions  PendingAction[]
  complaints      Complaint[]
  contacts        SiteContact[]
  documentRequirements SiteDocumentRequirement[]
  recdDelivery    RecdDelivery?
  units           RecdUnit[]

  /// Service region (drives which Regional Manager is reminded/escalated to).
  regionId        String?
  region          Region?  @relation(fields: [regionId], references: [id])
}

// ---------------------------------------------------------------------------
// Site contacts (one site can have several POCs - security desk, site engineer, etc.)
// ---------------------------------------------------------------------------

model SiteContact {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  /// Free-text role/designation at the site, e.g. "Security head", "Facility manager".
  role      String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Site document requirements (police verification, ESIC, insurance, PPE, ...)
// ---------------------------------------------------------------------------

/// Lookup table (data-not-code): the set of document types a site can require is seeded
/// data, not a code change, so a new requirement type is a DB insert (see seed.ts).
model DocumentRequirementType {
  id            String   @id @default(cuid())
  key           String   @unique
  label         String
  sequenceOrder Int
  createdAt     DateTime @default(now())

  siteRequirements SiteDocumentRequirement[]
}

model SiteDocumentRequirement {
  id                String                  @id @default(cuid())
  siteId            String
  site              Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  requirementTypeId String
  requirementType   DocumentRequirementType @relation(fields: [requirementTypeId], references: [id])
  required          Boolean                 @default(false)
  /// not_submitted | submitted | verified (free-form string, matches project convention)
  status            String                  @default("not_submitted")
  documentUrl       String?
  notes             String?
  updatedAt         DateTime                @updatedAt
  createdAt         DateTime                @default(now())

  @@unique([siteId, requirementTypeId])
}

// ---------------------------------------------------------------------------
// RECD delivery tracking (per-site material delivery status)
// ---------------------------------------------------------------------------

model RecdDelivery {
  id             String    @id @default(cuid())
  siteId         String    @unique
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id])
  quantity       Int?
  /// pending | in_transit | delivered (free-form string, matches project convention)
  deliveryStatus String    @default("pending")
  statusNote     String?
  /// Lower number = higher priority, matching the source delivery-tracking sheet.
  priority       Int?
  expectedDate   DateTime?
  actualDate     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// SITC stages & field status updates - lookup tables, not enums
// ---------------------------------------------------------------------------

enum SitcPhase {
  SUPPLY
  INSTALLATION
  TESTING
  COMMISSIONING
}

model StageDefinition {
  id            String    @id @default(cuid())
  key           String    @unique
  label         String
  phase         SitcPhase
  sequenceOrder Int
  createdAt     DateTime  @default(now())

  sites       Site[]
  stageEvents SiteStageEvent[]
}

/// Domain distinguishes which workflow a status option belongs to, so one table
/// can serve site-stage updates now and other workflows later without new tables.
model StatusOption {
  id              String   @id @default(cuid())
  domain          String   @default("site_stage")
  key             String
  label           String
  requiresComment Boolean  @default(true)
  sequenceOrder   Int
  createdAt       DateTime @default(now())

  stageEvents SiteStageEvent[]

  @@unique([domain, key])
}

model SiteStageEvent {
  id                String          @id @default(cuid())
  siteId            String
  site              Site            @relation(fields: [siteId], references: [id])
  stageDefinitionId String
  stageDefinition   StageDefinition @relation(fields: [stageDefinitionId], references: [id])
  statusOptionId    String
  statusOption      StatusOption    @relation(fields: [statusOptionId], references: [id])
  comment           String
  photoUrl          String?
  createdById       String
  createdBy         User            @relation(fields: [createdById], references: [id])
  createdAt         DateTime        @default(now())
}

// ---------------------------------------------------------------------------
// Photo checkpoints
// ---------------------------------------------------------------------------

model PhotoCheckpoint {
  id            String   @id @default(cuid())
  key           String   @unique
  label         String
  sequenceOrder Int
  createdAt     DateTime @default(now())

  photos SitePhoto[]
}

model SitePhoto {
  id           String          @id @default(cuid())
  siteId       String
  site         Site            @relation(fields: [siteId], references: [id])
  checkpointId String
  checkpoint   PhotoCheckpoint @relation(fields: [checkpointId], references: [id])
  photoUrl     String
  caption      String?
  uploadedById String
  uploadedBy   User            @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime        @default(now())
}

// ---------------------------------------------------------------------------
// Structure diagram module - Phase 2, schema ready now
// ---------------------------------------------------------------------------

model StructureType {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  /// JSON schema describing the parameters this structure type takes
  /// (e.g. dgCapacityKva, footprintLength, footprintWidth, platformHeight,
  /// legCount, bracingPattern, material, recdMountHeight).
  parameterSchema Json
  createdAt       DateTime @default(now())

  sites    Site[]
  examples StructureTemplateExample[]
}

model StructureTemplateExample {
  id              String        @id @default(cuid())
  structureTypeId String
  structureType   StructureType @relation(fields: [structureTypeId], references: [id])
  imageUrl        String
  parameters      Json
  notes           String?
  uploadedById    String
  uploadedAt      DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Pending actions (customer/internal/vendor approvals and blockers)
// ---------------------------------------------------------------------------

enum PendingActionOwnerType {
  INTERNAL
  CUSTOMER
  VENDOR
}

model PendingAction {
  id              String                 @id @default(cuid())
  siteId          String
  site            Site                   @relation(fields: [siteId], references: [id])
  /// e.g. "customer_approval", "material_shortage", "customer_signoff_pending" - see
  /// PENDING_ACTION_CATEGORY in packages/shared. Free-form on purpose; not a lookup
  /// table since these are created by code paths, not picked from a UI dropdown.
  category        String
  description     String
  ownerType       PendingActionOwnerType
  ownerUserId     String?
  ownerUser       User?                  @relation("InternalOwner", fields: [ownerUserId], references: [id])
  dueDate         DateTime?
  priority        String                 @default("medium") // low | medium | high | critical
  status          String                 @default("open")   // open | resolved
  escalationLevel Int                    @default(0)
  resolution      String?
  createdAt       DateTime               @default(now())
  resolvedAt      DateTime?
}

// ---------------------------------------------------------------------------
// Complaints
// ---------------------------------------------------------------------------

model Complaint {
  id             String    @id @default(cuid())
  ticketNumber   String    @unique
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  siteId         String?
  site           Site?     @relation(fields: [siteId], references: [id])
  category       String    // erection_commissioning | delivery_delay | non_performance
  /// Finer-grained issue picker shown alongside category - see ISSUE_CATEGORY in packages/shared.
  issueCategory  String?
  description    String
  severity       String    // low | medium | high | critical
  status         String    @default("open") // see COMPLAINT_STATUS in packages/shared
  assignedToId   String?
  assignedTo     User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  rootCause      String?
  resolutionNotes String?
  /// Customer-supplied photo at raise time (RECD/DG nameplate) - data URL, same pattern as SitePhoto.
  attachmentUrl  String?
  /// Staff-entered remarks while managing the ticket - distinct from resolutionNotes (closure summary).
  remarks        String?
  /// Staff-uploaded service report while managing the ticket - data URL, PDF/JPG/PNG.
  serviceReportUrl String?
  createdAt      DateTime  @default(now())
  closedAt       DateTime?
}

// ---------------------------------------------------------------------------
// AMC (Annual Maintenance Contract) orders
// ---------------------------------------------------------------------------

model AmcOrder {
  id                  String   @id @default(cuid())
  poNo                String
  poDate              DateTime
  customerId          String
  customer            Customer @relation(fields: [customerId], references: [id])
  location             String
  item                String
  qty                 Int
  amcFrequencyPerYear Int
  /// camc | namc - see AMC_TYPE in packages/shared
  amcType             String   @default("camc")
  /// yet_to_start | in_progress | completed - see AMC_ORDER_STATUS in packages/shared
  status              String   @default("yet_to_start")
  createdById         String?
  createdBy           User?    @relation("AmcOrderCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime @default(now())

  /// AMC expiry = poDate + 1 year. Reminders start 1 month before expiry and repeat
  /// every 3 days (see the send-expiry-reminders cron route) until cleared below.
  lastExpiryReminderAt     DateTime?
  expiryReminderClearedAt  DateTime?
  expiryReminderClearedById String?
  expiryReminderClearedBy  User?     @relation("AmcExpiryClearedBy", fields: [expiryReminderClearedById], references: [id])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model NotificationLog {
  id            String   @id @default(cuid())
  recipientId   String
  channel       String   // in_app | email | sms | whatsapp | telegram
  templateKey   String
  payload       Json
  /// "sent" for live channels, "pending_provider_setup" for stubbed channels (sms/whatsapp/telegram)
  status        String
  sentAt        DateTime?
  createdAt     DateTime @default(now())
}

model CompanySettings {
  id            String   @id @default("singleton")
  logoDataUrl   String?
  themeKey      String   @default("emerald")
  customColors  Json?

  /// Legal entity identity, printed as the letterhead on every DataTable "Print" view
  /// (see components/DataTable.tsx). Deliberately excludes the bank/tax/terms fields the
  /// upstream fork carries - those only exist for invoices/quotations/POs, which this app
  /// does not have.
  legalName            String?
  address              String?
  city                 String?
  pinCode              String?
  email                String?
  website              String?
  phone                String?
  /// Free-text note printed in the footer of every printed list (editable in Settings).
  documentFooterNote   String?

  /// In-app agent visibility (§24): role keys allowed to see the floating chat bubble.
  /// Empty array = hidden for everyone. Plain string array, not a relation/lookup table,
  /// since this is a small admin-editable allowlist, not growing data.
  agentVisibleRoleKeys String[] @default([])

  /// Free-text instructions from the admin, appended to the in-app agent's system prompt
  /// on every turn (e.g. "always confirm the site address before raising a complaint").
  agentCustomInstructions String?
}

// ---------------------------------------------------------------------------
// In-app agent
// ---------------------------------------------------------------------------

/// A user-configured LLM provider credential for the in-app agent. providerType is a plain
/// string (not a Prisma enum) per the project's data-not-code convention - new providers
/// (Google, Azure OpenAI, etc.) are a new adapter + a config row, not a migration. The API
/// key itself is stored encrypted (see lib/crypto.ts) - never returned to the frontend after
/// creation. Multiple rows can be active at once; the agent tries them in `priority` order
/// (lowest first) and falls back to the next on failure.
model AgentLlmProvider {
  id                String   @id @default(cuid())
  name              String   // user-given label, e.g. "My OpenAI key", "Groq fallback"
  providerType      String   // 'anthropic' | 'openai_compatible' (adapter lookup key)
  apiKeyCiphertext  String   // AES-256-GCM encrypted, base64 - never sent to the frontend
  baseUrl           String?  // for openai_compatible custom endpoints (Groq/Together/OpenRouter/etc)
  model             String   // model name to request from this provider
  priority          Int      @default(0) // lower tried first
  isActive          Boolean  @default(true)
  createdById       String
  createdBy         User     @relation("AgentLlmProviderCreator", fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// One chat thread with the in-app agent. `messages` holds the full UnifiedMessage[] array
/// (role/content/toolCalls/tool results) as JSON - a single-column blob rather than a
/// separate per-message table, since threads are read/written whole (never queried per-
/// message) and are short-lived (auto-deleted after 30 days by a daily cron). `title` is a
/// short label derived from the first user message, shown in the conversation list.
model AgentConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("AgentConversationUser", fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  pendingActions AgentPendingAction[]
}

/// A write action the agent has proposed but not yet executed - the confirm-gate for this
/// app's agent write tools (create_order, create_product). The tool handler creates one of
/// these instead of writing real data; only the confirm route performs the actual Prisma
/// write, reusing the same logic the real REST create-routes use. `input` is what the LLM
/// proposed (already validated); `preview` is the human-readable summary shown in the
/// confirm card.
model AgentPendingAction {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolName       String
  input          Json
  preview        Json
  /// pending | confirmed | rejected
  status         String            @default("pending")
  resultId       String?
  createdById    String
  createdBy      User              @relation("AgentPendingActionCreator", fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?

  @@index([conversationId])
}


// ---------------------------------------------------------------------------
// Regions & Regional Managers (admin-defined - regions are data, not code)
// ---------------------------------------------------------------------------

model Region {
  id        String   @id @default(cuid())
  /// URL-safe slug derived from the name; unique so a rename can't collide silently.
  key       String   @unique
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  managers RegionManager[]
  sites    Site[]
}

model RegionManager {
  regionId String
  userId   String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([regionId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// RECD units - one row per physical RECD. Service history, reports, warranty and AMC
// attach to the unit, identified by its globally-unique serial number.
// ---------------------------------------------------------------------------

model RecdUnit {
  id        String   @id @default(cuid())
  /// Globally unique. Null only for legacy units awaiting entry ("serial pending");
  /// every API path that creates a unit requires one.
  serialNo  String?  @unique
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  /// Set for units that came from an extra product line on the order (OrderLineItem);
  /// removing that line removes its units. Null = units of the order's own product.
  lineItemId String?
  lineItem  OrderLineItem? @relation(fields: [lineItemId], references: [id], onDelete: SetNull)
  /// active | retired - see RECD_UNIT_STATUS. A retired unit keeps its serial reserved.
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([siteId])
}

// ---------------------------------------------------------------------------
// Audit trail for user administration (create / edit / role change / (de)activate)
// ---------------------------------------------------------------------------

model UserAuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String
  target       User     @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  /// see USER_AUDIT_ACTION in packages/shared
  action       String
  /// Before/after values of whatever changed (never passwords/hashes).
  changes      Json?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
}
